# Copy to .env for local dev (bun/vite loads it automatically) and set the
# real value in your hosting platform's environment variables for
# production (e.g. Vercel → Project → Settings → Environment Variables).
#
# This is the ONLY Cloudinary value that's actually secret — cloud name and
# API key are hardcoded as public constants in src/lib/cloudinary-config.ts,
# same as the Firebase web config. Never prefix this with VITE_ — that
# prefix tells Vite to inline the value into the client bundle, which would
# expose it to every visitor.
CLOUDINARY_API_SECRET=

# Needed for push notifications to actually send (src/server/push-notify.ts).
# Firebase Console -> Project Settings -> Service accounts -> "Generate new
# private key" -> downloads a JSON file -> paste its FULL CONTENTS here as
# ONE LINE (most editors have a "join lines" or you can minify it with any
# JSON tool). This is a real secret — same rules as above: no VITE_ prefix,
# never commit it, server-only. Until this is set, notifyNewProduct/
# notifyBuyer/notifyAdminNewOrder will throw a clear "not configured" error
# instead of silently pretending to work — that's intentional.
FIREBASE_SERVICE_ACCOUNT_JSON=
